# Copy to .env. Loaded by src/bin/* only (never by tests).

NODE_ENV=development
# Loopback for local runs (smee forwards to localhost). Use 0.0.0.0 only inside a container.
HOST=127.0.0.1
PORT=3000
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# Compose database (pnpm db:up)
DATABASE_URL=postgres://graft:graft@localhost:55432/graft

# GitHub App. For a local run without a real App, any numeric ID and a throwaway key work:
#   openssl genrsa -out dev.pem 2048
GITHUB_APP_ID=123456
# Set exactly ONE of the two key variables (PEM; literal \n is accepted in the inline form).
GITHUB_APP_PRIVATE_KEY_PATH=./dev.pem
# GITHUB_APP_PRIVATE_KEY=
# At least 16 characters. Must equal the App's webhook secret. Generate one with
#   openssl rand -hex 32
# (the placeholder below is refused when NODE_ENV=production).
GITHUB_WEBHOOK_SECRET=change-me-dev-webhook-secret
GITHUB_API_URL=https://api.github.com

# pg-boss
PGBOSS_SCHEMA=pgboss
WORKER_CONCURRENCY=5

# Webhook body cap in bytes (GitHub's limit is 25 MB)
WEBHOOK_BODY_LIMIT_BYTES=26214400

# Only used by `pnpm tunnel` (https://smee.io/new)
# SMEE_URL=https://smee.io/CHANGE-ME

# Provenance (step 2)
# Comma-separated GitHub logins that always count as agent accounts (e.g. "my-agent[bot]").
GRAFT_AGENT_LOGINS=
# Co-authored-by emails that mark a commit as agent-written (default: Claude Code's).
GRAFT_AGENT_COAUTHOR_EMAILS=noreply@anthropic.com
# The App's slug. Enables the "<slug>[bot]" fallback for recognising Graft's own PR comment
# when performed_via_github_app is missing from the comments API (decision D13).
# Stored lowercased (Phase 1 step 7).
# GITHUB_APP_SLUG=graft-dev

# Intent cards (step 3)
# Without an API key the service still runs: cards show as "unavailable" with the rule-based risk floor.
# Never commit a real key.
# ANTHROPIC_API_KEY=
# Or a bearer token instead (set at most one), for gateways such as OpenRouter or Vercel AI Gateway.
# ANTHROPIC_AUTH_TOKEN=
# Or Workload Identity Federation (no long-lived key): all four of the first variables, and neither
# of the two above. See docs/configuration.md#deploying-with-federation.
# ANTHROPIC_FEDERATION_RULE_ID=fdrl_...
# ANTHROPIC_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000
# ANTHROPIC_SERVICE_ACCOUNT_ID=svac_...
# ANTHROPIC_IDENTITY_TOKEN_FILE=/var/run/secrets/anthropic.com/token
# Only when the rule is enabled for more than one workspace:
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
# Any service that speaks the Anthropic Messages API; unset means the Claude API. Diffs are sent
# there: check its data retention. Example: https://openrouter.ai/api
# (with OpenRouter, model IDs look like anthropic/claude-sonnet-5.5).
# ANTHROPIC_BASE_URL=
# Fast model: first pass when the rule-based floor is trivial. Strong model: everything else, and always the verifier.
GRAFT_LLM_MODEL_FAST=claude-haiku-5-5
GRAFT_LLM_MODEL_STRONG=claude-sonnet-5-5
# Per-call timeout in ms (5000-600000) and SDK retries (0-5).
GRAFT_LLM_TIMEOUT_MS=120000
GRAFT_LLM_MAX_RETRIES=2
# Let the API retry a refused request on a substitute model (Sonnet/Opus only).
GRAFT_LLM_REFUSAL_FALLBACK=true
# A model Graft retries once itself when a call is refused and no server-side fallback ran
# (gateways, clouds, Haiku). Unset: off.
# GRAFT_LLM_REFUSAL_FALLBACK_MODEL=claude-opus-5-5
# Per-repository daily token budget; 0 = unlimited.
GRAFT_LLM_DAILY_TOKEN_BUDGET=2000000
# Extra globs (comma-separated) that set the risk floor to "sensitive", for example services/billing/**
GRAFT_INTENT_SENSITIVE_PATHS=
# Cron for polling 👍/👎 reactions on the managed comment, or "off".
GRAFT_FEEDBACK_POLL_CRON=*/15 * * * *

# Pilots and gate (step 6)
# Label that marks a revert or fix PR as an incident ("off" disables). The fix PR's body names the
# culprit as `Reverts owner/repo#N` or a line `Graft-Culprit: #N`.
GRAFT_INCIDENT_LABEL=incident
# Cron for the daily metrics rollup (recomputes the last 7 UTC days), or "off".
GRAFT_METRICS_ROLLUP_CRON=15 2 * * *
# Authors left out of the baseline, the rollup PR counts and the gate coverage.
GRAFT_METRICS_EXCLUDED_AUTHORS=dependabot[bot],renovate[bot]

# Modes (Phase 1 step 1). Leave GRAFT_MODE_CEILING at "report" until the rollout runbook says
# otherwise: it caps every repository's policy_mode, guard_mode and mcp_write.
GRAFT_MODE_CEILING=report
# Cron for the worker job that republishes policy checks after `graft mode set`, or "off".
GRAFT_MODE_APPLY_CRON=* * * * *
# Cron for the daily refresh of each installation's permissions from the API, or "off".
GRAFT_PERMISSIONS_REFRESH_CRON=30 3 * * *
# Phase 1 step 2: in enforce mode, how long (seconds, 0-3600) graft/policy stays in_progress while
# the intent card for the head is written. 0 never waits. Ignored in report mode.
GRAFT_POLICY_CARD_WAIT_SECONDS=600
# Phase 1 step 3: the label that bypasses the policy for one commit when a maintainer or admin
# applies it (matched case-insensitively, 1-50 characters). "off" disables break-glass.
GRAFT_BREAK_GLASS_LABEL=graft:break-glass
# Phase 1 step 4: the post-merge guard. "off" stops it (handlers drop events, crons do nothing).
GRAFT_GUARD_DETECTION=on
# Wait for a red default-branch check to persist (next commit or the window below) before naming
# a culprit. "off" makes the outcome final at detection.
GRAFT_GUARD_CONFIRM=on
# The confirmation window, in seconds (300-86400).
GRAFT_GUARD_CONFIRM_SECONDS=7200
# How long the guard waits after a CI or push event before reading results (0-600 seconds).
GRAFT_GUARD_OBSERVE_DELAY_SECONDS=30
# Days of default-branch commits and CI results kept (7-365).
GRAFT_GUARD_RETENTION_DAYS=30
# Cron for the daily guard.prune job, or "off".
GRAFT_GUARD_PRUNE_CRON=45 3 * * *
# Phase 1 step 5: revert pull requests for a confirmed culprit (enforce mode only; report mode
# shows the plan). "off" stops reverts; detection is unaffected.
GRAFT_GUARD_REVERT=on
# At most this many revert pull requests open per repository (1-10).
GRAFT_GUARD_MAX_OPEN_REVERTS=3
# A culprit that changed more paths than this (1-1000) is left to a human.
GRAFT_GUARD_REVERT_MAX_PATHS=300
# Tree reads one revert plan may make (10-1000); more is left to a human.
GRAFT_GUARD_REVERT_MAX_TREE_READS=200
# A culprit confirmed more than this many hours ago (1-168) is never reverted (skipped / stale).
GRAFT_GUARD_REVERT_MAX_AGE_HOURS=24
# Phase 1 step 6: the MCP endpoint (/mcp on the server). "off" removes the route (404); tokens
# are still managed with `pnpm graft mcp-token`. Nothing is reachable without a token.
GRAFT_MCP=on
# Comma-separated browser origins allowed to call /mcp (scheme://host[:port]). Empty refuses any
# request with an Origin header; agents send none.
GRAFT_MCP_ALLOWED_ORIGINS=
# Requests per token per minute (1-600), per server process.
GRAFT_MCP_RATE_LIMIT_PER_MINUTE=60
# Failed authentications per client IP per minute (1-600), per server process.
GRAFT_MCP_AUTH_FAILURES_PER_MINUTE=20
# PRs `open_change` may open per repository in any rolling hour (1-100), across processes.
GRAFT_MCP_OPEN_CHANGE_PER_HOUR=10
# Active MCP tokens per repository (1-50).
GRAFT_MCP_MAX_TOKENS_PER_REPO=10
# Phase 1 step 7 (D6): the proxies in front of /mcp whose X-Forwarded-For is trusted, as IP
# addresses or CIDR ranges (comma-separated). Empty: the connection's peer is the client address,
# so every client behind a proxy shares one failed-auth bucket. Never "true", a hop count or a name.
# GRAFT_TRUST_PROXY=10.0.0.5,fd00::/8

# Evaluation set (step 4). Pilot case sets live OUTSIDE the repo and are encrypted at rest.
# Directory holding pilot sets (default ~/.graft-eval). Exclude it from backups and cloud sync.
# GRAFT_EVAL_DIR=
# NEVER here: keep GRAFT_EVAL_KEY in the password manager and pass it in the shell
# (`pnpm eval keygen` makes one). Listed only so that you know its name.
# GRAFT_EVAL_KEY=
# Read-only fine-grained token for `pnpm eval export --auth token` (pilots without the App installed).
# GRAFT_EVAL_GITHUB_TOKEN=
