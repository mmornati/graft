# Copy to .env. Loaded by src/bin/* only (never by tests).

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# Compose database (pnpm db:up)
DATABASE_URL=postgres://graft:graft@localhost:55432/graft

# GitHub App. For a local run without a real App, any numeric ID and a throwaway key work:
#   openssl genrsa -out dev.pem 2048
GITHUB_APP_ID=123456
# Set exactly ONE of the two key variables (PEM; literal \n is accepted in the inline form).
GITHUB_APP_PRIVATE_KEY_PATH=./dev.pem
# GITHUB_APP_PRIVATE_KEY=
# At least 16 characters. Must equal the App's webhook secret.
GITHUB_WEBHOOK_SECRET=change-me-dev-webhook-secret
GITHUB_API_URL=https://api.github.com

# pg-boss
PGBOSS_SCHEMA=pgboss
WORKER_CONCURRENCY=5

# Webhook body cap in bytes (GitHub's limit is 25 MB)
WEBHOOK_BODY_LIMIT_BYTES=26214400

# Only used by `pnpm tunnel` (https://smee.io/new)
# SMEE_URL=https://smee.io/CHANGE-ME

# Provenance (step 2)
# Comma-separated GitHub logins that always count as agent accounts (e.g. "my-agent[bot]").
GRAFT_AGENT_LOGINS=
# Co-authored-by emails that mark a commit as agent-written (default: Claude Code's).
GRAFT_AGENT_COAUTHOR_EMAILS=noreply@anthropic.com
# The App's slug. Enables the "<slug>[bot]" fallback for recognising Graft's own PR comment
# when performed_via_github_app is missing from the comments API (decision D13).
# GITHUB_APP_SLUG=graft-dev

# Intent cards (step 3)
# Without an API key the service still runs: cards show as "unavailable" with the rule-based risk floor.
# Never commit a real key.
# ANTHROPIC_API_KEY=
# Fast model: first pass when the rule-based floor is trivial. Strong model: everything else, and always the verifier.
GRAFT_LLM_MODEL_FAST=claude-haiku-5-5
GRAFT_LLM_MODEL_STRONG=claude-sonnet-5-5
# Per-call timeout in ms (5000-600000) and SDK retries (0-5).
GRAFT_LLM_TIMEOUT_MS=120000
GRAFT_LLM_MAX_RETRIES=2
# Let the API retry a refused request on a substitute model (Sonnet/Opus only).
GRAFT_LLM_REFUSAL_FALLBACK=true
# Per-repository daily token budget; 0 = unlimited.
GRAFT_LLM_DAILY_TOKEN_BUDGET=2000000
# Extra globs (comma-separated) that set the risk floor to "sensitive", for example services/billing/**
GRAFT_INTENT_SENSITIVE_PATHS=
# Cron for polling 👍/👎 reactions on the managed comment, or "off".
GRAFT_FEEDBACK_POLL_CRON=*/15 * * * *

# Pilots and gate (step 6)
# Label that marks a revert or fix PR as an incident ("off" disables). The fix PR's body names the
# culprit as `Reverts owner/repo#N` or a line `Graft-Culprit: #N`.
GRAFT_INCIDENT_LABEL=incident
# Cron for the daily metrics rollup (recomputes the last 7 UTC days), or "off".
GRAFT_METRICS_ROLLUP_CRON=15 2 * * *
# Authors left out of the baseline, the rollup PR counts and the gate coverage.
GRAFT_METRICS_EXCLUDED_AUTHORS=dependabot[bot],renovate[bot]

# Evaluation set (step 4). Pilot case sets live OUTSIDE the repo and are encrypted at rest.
# Directory holding pilot sets (default ~/.graft-eval). Exclude it from backups and cloud sync.
# GRAFT_EVAL_DIR=
# NEVER here: keep GRAFT_EVAL_KEY in the password manager and pass it in the shell
# (`pnpm eval keygen` makes one). Listed only so that you know its name.
# GRAFT_EVAL_KEY=
# Read-only fine-grained token for `pnpm eval export --auth token` (pilots without the App installed).
# GRAFT_EVAL_GITHUB_TOKEN=
