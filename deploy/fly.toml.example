# Fly.io configuration for Graft. Copy it to the repository root as fly.toml, set `app` and
# `primary_region`, then follow docs/deploy/fly.md. Secrets are set with `fly secrets set`, never here.

app = "graft-CHANGE-ME"
primary_region = "cdg"

[build]
  dockerfile = "Dockerfile"

[deploy]
  # Runs on a temporary machine with the app's secrets before new machines start.
  release_command = "node dist/bin/migrate.js up"
  strategy = "rolling"

[env]
  NODE_ENV = "production"
  HOST = "0.0.0.0"
  PORT = "3000"
  LOG_LEVEL = "info"
  # Leave at report until the Phase 1 rollout runbook says otherwise.
  GRAFT_MODE_CEILING = "report"

# One image, two processes: the webhook server and the job worker.
[processes]
  app = "node dist/bin/server.js"
  worker = "node dist/bin/worker.js"

[http_service]
  internal_port = 3000
  force_https = true
  # GitHub gives a webhook 10 seconds: keep the server warm instead of cold-starting it.
  auto_stop_machines = "off"
  auto_start_machines = true
  min_machines_running = 1
  processes = ["app"]

  [[http_service.checks]]
    grace_period = "20s"
    interval = "30s"
    method = "GET"
    path = "/readyz"
    timeout = "5s"

[[vm]]
  size = "shared-cpu-1x"
  memory = "512mb"
  processes = ["app", "worker"]
